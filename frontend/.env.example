API_BASE_URL=http://localhost:8080
# CDN 基础 URL（可选，构建时传入，不设置则使用相对路径）
NEXT_PUBLIC_CDN_URL=
# 腾讯云 COS（上传脚本使用，运行时传入，不要硬编码）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# 开源计划进度条（0-100）
NEXT_PUBLIC_OPENSOURCE_PROGRESS=15
NEXT_PUBLIC_SITE_URL=https://aliang.one

# Cloudflare Turnstile（注册防滥用）。site key 前端公开；secret key 配在后端 TURNSTILE_SECRET_KEY。
# 两侧同时配置才启用人机验证；留空则注册页不渲染组件、后端跳过校验。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
